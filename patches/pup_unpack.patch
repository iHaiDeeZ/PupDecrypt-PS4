+        // Stream.Read may return fewer bytes than asked for (inflater streams do on newer .NET),
+        // so keep reading until the count is reached or the stream ends.
+        private static int ReadFull(Stream input, byte[] buffer, int offset, int count)
+        {
+            int total = 0;
+            while (total < count)
+            {
+                var read = input.Read(buffer, offset + total, count - total);
+                if (read <= 0)
+                {
+                    break;
+                }
+                total += read;
+            }
+            return total;
+        }
