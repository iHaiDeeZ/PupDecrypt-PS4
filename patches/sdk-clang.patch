diff --git a/libPS4/include/debug.h b/libPS4/include/debug.h
index c9e1667..b36e2d7 100644
--- a/libPS4/include/debug.h
+++ b/libPS4/include/debug.h
@@ -10,17 +10,28 @@
 
 extern int DEBUG_SOCK;
 
+// Zeroes a buffer without a library call: clang turns '= {0}' on big locals into a direct
+// call to the symbol 'memset', which here is the libc function pointer in .bss, not a function.
+static inline __attribute__((always_inline)) void payload_bzero(void *p, unsigned long n) {
+  __asm__ volatile("rep stosb"
+                   : "+D"(p), "+c"(n)
+                   : "a"(0)
+                   : "memory");
+}
+
 #define printf_debug(...)                                                                                                  \
   do {                                                                                                                     \
     {                                                                                                                      \
-      char debug_message[256] = {0};                                                                                       \
+      char debug_message[256];                                                                                             \
+      payload_bzero(debug_message, sizeof(debug_message));                                                                 \
       int size = snprintf_s(debug_message, sizeof(debug_message), "[DEBUG] [%s (%s:%d)] ", __FILE__, __FUNCTION__, __LINE__); \
       syscall(601, 7, debug_message, 0);                                                                                   \
       if (DEBUG_SOCK >= 0) {                                                                                               \
         SckSend(DEBUG_SOCK, debug_message, size);                                                                          \
       }                                                                                                                    \
     }                                                                                                                      \
-    char debug_message[512] = {0};                                                                                         \
+    char debug_message[512];                                                                                               \
+    payload_bzero(debug_message, sizeof(debug_message));                                                                   \
     int size = snprintf_s(debug_message, sizeof(debug_message), ##__VA_ARGS__);                                            \
     syscall(601, 7, debug_message, 0);                                                                                     \
     if (DEBUG_SOCK >= 0) {                                                                                                 \
